<?xml version="1.0"?>
<!DOCTYPE Xdmf SYSTEM "Xdmf.dtd" []>
<Xdmf Version="3.0" xmlns:xi="https://www.w3.org/2001/XInclude">
  <Domain>
    <Grid Name="mesh" GridType="Uniform">
      <Topology TopologyType="Triangle" NumberOfElements="11098" NodesPerElement="3">
        <DataItem Dimensions="11098 3" NumberType="Int" Format="HDF">obstacle_cells.h5:/Mesh/mesh/topology</DataItem>
      </Topology>
      <Geometry GeometryType="XY">
        <DataItem Dimensions="5752 2" Format="HDF">obstacle_cells.h5:/Mesh/mesh/geometry</DataItem>
      </Geometry>
    </Grid>
    <Grid Name="obstacle_cells" GridType="Collection" CollectionType="Temporal">
      <Grid Name="obstacle_cells" GridType="Uniform">
        <xi:include xpointer="xpointer(/Xdmf/Domain/Grid[@GridType='Uniform'][1]/*[self::Topology or self::Geometry])" />
        <Time Value="0" />
        <Attribute Name="obstacle_cells" AttributeType="Scalar" Center="Cell">
          <DataItem Dimensions="11098 1" Format="HDF">obstacle_cells.h5:/Function/obstacle_cells/0</DataItem>
        </Attribute>
      </Grid>
    </Grid>
  </Domain>
</Xdmf>
